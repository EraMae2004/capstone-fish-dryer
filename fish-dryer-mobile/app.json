{
  "expo": {
    "name": "fish-dryer-mobile",
    "slug": "fish-dryer-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fishdryermobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-font",
      "expo-image",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiBaseUrl": "http://10.38.125.15:8000/api",
      "firebase": {
        "apiKey": "AIzaSyCO0FjIGLXYJcNepqraUb61jUYLyrk8oAk",
        "authDomain": "capstone-fish-dryer.firebaseapp.com",
        "databaseURL": "https://capstone-fish-dryer-default-rtdb.asia-southeast1.firebasedatabase.app",
        "projectId": "capstone-fish-dryer",
        "storageBucket": "capstone-fish-dryer.firebasestorage.app",
        "messagingSenderId": "512364781046",
        "appId": "1:512364781046:web:bcb5f4acde7379cb3ffbd7",
        "measurementId": "G-JPHWBG3H8F"
      }
    }
  }
}
