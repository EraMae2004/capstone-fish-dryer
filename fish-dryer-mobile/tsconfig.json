{
  "compilerOptions": {
    "strict": true,

    // Expo defaults (normally provided by `extends: "expo/tsconfig.base"`).
    // Some editors/diagnostics paths don't reliably apply `extends`, which causes
    // `.tsx` files to be typechecked as plain `.ts` (hundreds of bogus JSX errors).
    "allowJs": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react-native",
    "lib": ["DOM", "ESNext"],
    "module": "preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "customConditions": ["react-native"],
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "target": "ESNext",

    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": ["node_modules"]
}
